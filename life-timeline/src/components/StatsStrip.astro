---
// ============================================================
// StatsStrip — 首页轻量统计条（服务端渲染，无客户端 JS）
// ============================================================

import type { LifeStats } from '../lib/stats';
import { t } from '../lib/i18n';
import { to } from '../lib/base';

interface Props {
  stats: LifeStats;
}

const { stats } = Astro.props;

const items = [
  { href: to('/dashboard'), emoji: '🧬', label: t.statsStrip.days(stats.ageDays) },
  { href: to('/timeline'), emoji: '📅', label: t.statsStrip.events(stats.eventCount) },
  { href: to('/travel'), emoji: '🗺️', label: t.statsStrip.travel(stats.provinceCount, stats.cityCount) },
  { href: to('/blog'), emoji: '📝', label: t.statsStrip.posts(stats.postCount) },
  { href: to('/consumptions'), emoji: '📚', label: t.statsStrip.read(stats.consumptionCounts.done) },
  { href: to('/dashboard'), emoji: '🎯', label: t.statsStrip.goals(stats.goalDoneRate) },
];
---

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl px-4 py-3 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 text-center"
      >
        <div class="text-xl mb-1">{item.emoji}</div>
        <div class="text-sm font-semibold">{item.label}</div>
      </a>
    ))
  }
</div>
