---
// ============================================================
// /yearly — 年度回顾索引（仅列出有数据的年份）
// ============================================================

import Layout from '../../layouts/Layout.astro';
import { loadLifeStats } from '../../lib/stats';
import { t } from '../../lib/i18n';
import { to } from '../../lib/base';

const stats = await loadLifeStats();
const years = stats.yearly;
---

<Layout title={t.yearly.heading} description={t.yearly.description}>
  <div class="space-y-8">
    <div>
      <a
        href={to('/dashboard')}
        class="text-sm text-base-content/60 hover:text-base-content transition-colors"
      >
        {t.yearly.backToDashboard}
      </a>
      <h1 class="text-3xl font-bold tracking-tight mt-2">{t.yearly.heading}</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">{t.yearly.description}</p>
    </div>

    {
      years.length === 0 ? (
        <p class="text-sm text-gray-400 dark:text-gray-500">{t.yearly.empty}</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            years.map((y) => (
              <a
                href={to(`/yearly/${y.year}`)}
                class="card bg-base-100 border border-base-300 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <div class="flex items-baseline justify-between">
                  <span class="text-2xl font-bold tracking-tight">{y.year}</span>
                  <span class="text-xs text-gray-400 dark:text-gray-500">{y.eventCount} {t.yearly.events}</span>
                </div>
                <div class="mt-2 text-xs text-gray-500 dark:text-gray-400 space-y-1">
                  <div>
                    {y.importantCount} {t.yearly.important} · {y.postCount} {t.yearly.posts} · {y.doneCount} {t.yearly.read}
                  </div>
                  <div>{y.cityCount} {t.yearly.cities}</div>
                </div>
                {
                  y.topTags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1 items-center">
                      <span class="text-[10px] text-gray-400 dark:text-gray-500 mr-1">{t.yearly.tags}</span>
                      {y.topTags.slice(0, 4).map((tag) => (
                        <span class="badge badge-xs badge-ghost text-[10px]">{tag.name}</span>
                      ))}
                    </div>
                  )
                }
              </a>
            ))
          }
        </div>
      )
    }
  </div>
</Layout>
