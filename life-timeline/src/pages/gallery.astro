---
import Layout from '../layouts/Layout.astro';
import MediaGallery from '../components/MediaGallery';
import { t } from '../lib/i18n';
import { loadMedia } from '../lib/parseMedia';

const media = await loadMedia();
---

<Layout title={t.gallery.heading} description={t.gallery.description}>
  <div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight mb-2">{t.gallery.heading}</h1>
    <p class="text-gray-500 dark:text-gray-400 text-sm">{t.gallery.description}</p>
  </div>

  <MediaGallery media={media} client:only="react" />
</Layout>
