---
import Layout from '../../layouts/Layout.astro';
import AdminPanel from '../../components/admin/AdminPanel';
import { loadEvents } from '../../lib/parseEvents';
import { loadPosts } from '../../lib/parsePosts';
import { loadProfile } from '../../lib/parseProfile';
import { loadGoals } from '../../lib/parseGoals';
import { loadMedia } from '../../lib/parseMedia';
import { loadConsumptions } from '../../lib/parseConsumptions';
import type { RelationsData } from '../../lib/types';
import { t } from '../../lib/i18n';
import relationsData from '../../data/relations.json';

// 管理后台仅本地开发使用：生产构建输出为跳转首页的静态重定向页
if (!import.meta.env.DEV) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const allEvents = await loadEvents(true);
const allPosts = await loadPosts(true);
const profile = await loadProfile();
const goalData = await loadGoals();
const allGoals = [...goalData.short, ...goalData.long];
const allMedia = await loadMedia();
const consumptionData = await loadConsumptions();
---

<Layout title={t.admin.heading} description={t.admin.description}>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t.admin.heading}</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">
        {t.admin.description}{t.admin.fileSavedTo}
        <code class="text-xs bg-gray-50 dark:bg-gray-950 px-1.5 py-0.5 rounded">{t.admin.dir}</code> {t.admin.and}
        <code class="text-xs bg-gray-50 dark:bg-gray-950 px-1.5 py-0.5 rounded">{t.admin.blogDir}</code> {t.admin.and}
        <code class="text-xs bg-gray-50 dark:bg-gray-950 px-1.5 py-0.5 rounded">{t.admin.profileDir}</code> 目录，目标保存到 <code class="text-xs bg-gray-50 dark:bg-gray-950 px-1.5 py-0.5 rounded">src/data/goals.json</code>。
      </p>
      <div class="mt-3 px-3 py-2 bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 rounded-lg text-sm text-yellow-500-content/80">
        ⚠️ {t.admin.warning} (<code>{t.admin.devOnly}</code>) {t.admin.warningSuffix}
      </div>
    </div>

    <AdminPanel
      events={allEvents}
      posts={allPosts}
      profile={profile}
      goals={allGoals}
      media={allMedia}
      consumptions={consumptionData.items}
      relations={relationsData as unknown as RelationsData}
      client:load
    />
  </div>
</Layout>
