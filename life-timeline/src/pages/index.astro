---
import Layout from '../layouts/Layout.astro';
import LifeGrid from '../components/LifeGrid';
import LifeCounter from '../components/LifeCounter';
import GoalBoard from '../components/GoalBoard';
import StatsStrip from '../components/StatsStrip.astro';
import { loadEvents, buildGridData } from '../lib/parseEvents';
import { loadProfile } from '../lib/parseProfile';
import { loadGoals } from '../lib/parseGoals';
import { loadLifeStats } from '../lib/stats';
import { t } from '../lib/i18n';
import { to } from '../lib/base';
import { siteConfig } from '../site.config';

const events = await loadEvents();
const profile = await loadProfile();
const goalData = await loadGoals();
const stats = await loadLifeStats();
const gridData = buildGridData(events, siteConfig.birthYear);
const totalEvents = events.length;

/** LifeCounter 优先使用个人档案的出生日期，回退到站点配置 */
const birthDate = profile?.birthDate ?? siteConfig.birthDate;
---

<Layout title={t.home.heading}>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t.home.heading}</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400" set:html={t.home.summary(gridData.startYear, gridData.endYear, totalEvents)} />
    </div>

    <LifeCounter birthDate={birthDate} client:load />

    <StatsStrip stats={stats} />

    <GoalBoard data={goalData} client:load />

    <!-- 人生清单入口 -->
    <a
      href={to('/bucket-list')}
      class="card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm p-4 flex items-center justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
    >
      <div class="flex items-center gap-3">
        <span class="text-xl">🎯</span>
        <div>
          <p class="text-sm font-semibold">{t.home.bucketList}</p>
          <p class="text-xs text-gray-400 dark:text-gray-500">
            {stats.bucketListCounts.done} / {stats.bucketListCounts.total}
          </p>
        </div>
      </div>
      <span class="text-sm text-green-600 dark:text-green-400 group-hover:translate-x-0.5 transition-transform shrink-0">
        {t.home.viewBucketList} →
      </span>
    </a>

    <div class="card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
      <div class="card-body">
        <LifeGrid data={gridData} client:load />
      </div>
    </div>

    <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-800">
      <a href={to('/timeline')} class="btn btn-primary">
        {t.home.viewTimeline} →
      </a>
    </div>
  </div>
</Layout>
