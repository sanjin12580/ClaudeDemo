---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard';
import { loadEvents } from '../../lib/parseEvents';
import { t } from '../../lib/i18n';
import { to } from '../../lib/base';

export async function getStaticPaths() {
  const events = await loadEvents();
  const years = new Set<string>();
  for (const e of events) {
    years.add(e.date.slice(0, 4));
  }
  return Array.from(years).map((year) => ({ params: { year } }));
}

const { year } = Astro.params;

const allEvents = await loadEvents();
const yearEvents = allEvents.filter((e) => e.date.startsWith(year));

const monthGroups = new Map<string, typeof yearEvents>();
for (const event of yearEvents) {
  const month = event.date.slice(0, 7);
  if (!monthGroups.has(month)) monthGroups.set(month, []);
  monthGroups.get(month)!.push(event);
}
---

<Layout title={`${year} 年`}>
  <div class="space-y-8">
    <div>
      <a
        href={to('/timeline')}
        class="text-sm text-gray-400 dark:text-gray-500 hover:text-gray-800 dark:text-gray-200 transition-colors"
      >
        ← {t.yearPage.back}
      </a>
      <h1 class="text-3xl font-bold tracking-tight mt-2">{year} 年</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">
        {t.yearPage.count(yearEvents.length)}
      </p>
    </div>

    {
      yearEvents.length === 0 ? (
        <div class="text-center py-16 text-gray-400 dark:text-gray-500">
          {t.yearPage.empty}
          <br />
          <a href="/admin" class="text-green-600 dark:text-green-400 hover:underline text-sm mt-2 inline-block">
            {t.yearPage.goAdd}
          </a>
        </div>
      ) : (
        <div class="space-y-10">
          {Array.from(monthGroups.entries())
            .sort(([a], [b]) => b.localeCompare(a))
            .map(([month, events]) => {
              const monthLabel = `${parseInt(month.slice(5), 10)} 月`;
              return (
                <section data-month={month}>
                  <h2 class="text-2xl font-bold text-gray-200 dark:text-gray-700 mb-4">
                    {monthLabel}
                  </h2>
                  <div class="space-y-3 pl-6 border-l-2 border-green-200 dark:border-green-800">
                    {events.map((event) => (
                      <div class="relative">
                        <div class="absolute -left-[calc(1.5rem+5px)] top-5 w-2.5 h-2.5
                                    rounded-full bg-green-600 dark:bg-green-500 ring-2 ring-base-100" />
                        <EventCard event={event} client:load />
                      </div>
                    ))}
                  </div>
                </section>
              );
            })
          }
        </div>
      )
    }
  </div>
</Layout>
