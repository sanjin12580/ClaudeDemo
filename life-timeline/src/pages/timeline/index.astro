---
import Layout from '../../layouts/Layout.astro';
import Timeline from '../../components/Timeline';
import { loadEvents } from '../../lib/parseEvents';
import { t } from '../../lib/i18n';

const events = await loadEvents();
const editable = import.meta.env.DEV;
---

<Layout title={t.timeline.heading} description={t.timeline.description}>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t.timeline.heading}</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">
        {t.timeline.description}
      </p>
    </div>

    <Timeline events={events} editable={editable} client:load />
  </div>
</Layout>
