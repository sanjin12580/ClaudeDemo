---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';
import { CATEGORY_COLORS } from '../../lib/types';

export async function getStaticPaths() {
  const entries = await getCollection('events', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
  }));
}

const { slug } = Astro.params;

// 查找匹配的事件
const entries = await getCollection('events');
const entry = entries.find((e) => e.id.replace(/\.(md|mdx)$/, '') === slug);
if (!entry) {
  return new Response(t.eventDetail.notFound, { status: 404 });
}

const { Content } = await entry.render();
const { date, title, category, tags, importance, location } = entry.data;
const catColor = CATEGORY_COLORS[category] || CATEGORY_COLORS['其他'];

// 格式化日期
function formatDate(dateStr: string): string {
  const parts = dateStr.split('-');
  if (parts.length === 3) return `${parts[0]} 年 ${parseInt(parts[1])} 月 ${parseInt(parts[2])} 日`;
  if (parts.length === 2) return `${parts[0]} 年 ${parseInt(parts[1])} 月`;
  return `${parts[0]} 年`;
}

// 上一篇 / 下一篇
const allEntries = await getCollection('events', ({ data }) => !data.draft);
allEntries.sort((a, b) => a.data.date.localeCompare(b.data.date));
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const nextEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;

function getSlug(e: NonNullable<typeof entry>): string {
  return e.id.replace(/\.(md|mdx)$/, '');
}
---

<Layout title={title} description={entry.body?.replace(/[#*`>!\[\\\]()]/g, '').slice(0, 160) ?? ''}>
  <article class="max-w-3xl mx-auto">
    <!-- 返回链接 -->
    <a
      href="/timeline"
      class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900
             dark:text-gray-400 dark:hover:text-gray-200 transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {t.eventDetail.back}
    </a>

    <!-- 元数据卡片 -->
    <header class="mb-10 p-6 rounded-xl bg-gray-50 dark:bg-gray-950 border border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${catColor}`}>
          {category}
        </span>
        <time class="text-sm text-gray-500 dark:text-gray-400 font-mono">
          {formatDate(date)}
        </time>
        {location && (
          <span class="text-sm text-gray-400 dark:text-gray-500">
            📍 {location}
          </span>
        )}
      </div>

      <h1 class="text-3xl font-bold tracking-tight mb-4">{title}</h1>

      <div class="flex items-center gap-4 flex-wrap">
        <!-- 星级 -->
        <span class="inline-flex gap-0.5" title={t.eventDetail.importance(importance)}>
          {Array.from({ length: 5 }, (_, i) => (
            <span class={`text-sm ${i < importance ? 'text-yellow-500' : 'text-gray-300 dark:text-gray-600'}`}>
              ★
            </span>
          ))}
        </span>

        <!-- 标签 -->
        {tags.length > 0 && (
          <div class="flex gap-1.5 flex-wrap">
            {tags.map((tag) => (
              <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-200/60 dark:bg-gray-800 px-2 py-0.5 rounded-full">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Markdown 正文 -->
    <div class="prose prose-gray dark:prose-invert max-w-none
                prose-headings:font-semibold prose-a:text-green-600 dark:prose-a:text-green-400
                prose-img:rounded-xl prose-img:shadow-md
                prose-pre:bg-gray-900 dark:prose-pre:bg-gray-800
                prose-code:bg-gray-100 dark:prose-code:bg-gray-800 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                prose-blockquote:border-green-400 prose-blockquote:bg-gray-50 dark:prose-blockquote:bg-gray-950
                prose-li:marker:text-gray-400">
      <Content />
    </div>

    <!-- 上一篇 / 下一篇导航 -->
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 grid grid-cols-2 gap-4">
      <div>
        {prevEntry ? (
          <a href={`/events/${getSlug(prevEntry)}`}
             class="group block p-4 rounded-lg border border-gray-200 dark:border-gray-800
                    hover:border-gray-400 dark:hover:border-gray-600 transition-all
                    hover:shadow-sm bg-white dark:bg-gray-900">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.prev}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
              {prevEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.prev}</span>
            <p class="text-sm text-gray-400 mt-1">—</p>
          </div>
        )}
      </div>
      <div>
        {nextEntry ? (
          <a href={`/events/${getSlug(nextEntry)}`}
             class="group block p-4 rounded-lg border border-gray-200 dark:border-gray-800
                    hover:border-gray-400 dark:hover:border-gray-600 transition-all
                    hover:shadow-sm bg-white dark:bg-gray-900 text-right">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.next}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
              {nextEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50 text-right">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.next}</span>
            <p class="text-sm text-gray-400 mt-1">—</p>
          </div>
        )}
      </div>
    </nav>
  </article>
</Layout>
