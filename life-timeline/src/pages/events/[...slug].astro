---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';
import { to, formatDate } from '../../lib/base';
import { CATEGORY_COLORS } from '../../lib/types';

export async function getStaticPaths() {
  const entries = await getCollection('events', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
  }));
}

const { slug } = Astro.params;

const entries = await getCollection('events');
const entry = entries.find((e) => e.id.replace(/\.(md|mdx)$/, '') === slug);
if (!entry) {
  return new Response(t.eventDetail.notFound, { status: 404 });
}

const { Content } = await entry.render();
const { date, title, category, tags, importance, location, images } = entry.data;
const catColor = CATEGORY_COLORS[category] || CATEGORY_COLORS['其他'];


const allEntries = await getCollection('events', ({ data }) => !data.draft);
allEntries.sort((a, b) => a.data.date.localeCompare(b.data.date));
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const nextEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;

function getSlug(e: NonNullable<typeof entry>): string {
  return e.id.replace(/\.(md|mdx)$/, '');
}
---

<Layout title={title} description={entry.body?.replace(/[#*`>!\[\\\]()]/g, '').slice(0, 160) ?? ''}>
  <article class="max-w-3xl mx-auto">
    <!-- 返回链接 -->
    <a
      href={to('/timeline')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 dark:text-gray-500 hover:text-gray-900 dark:text-gray-100 transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {t.eventDetail.back}
    </a>

    <!-- 元数据卡片 -->
    <header class="mb-10 p-6 rounded-box bg-base-200/60 border border-base-300">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class={`badge badge-sm font-medium ${catColor}`}>
          {category}
        </span>
        <time class="text-sm text-gray-500 dark:text-gray-400 font-mono tabular-nums">
          {formatDate(date)}
        </time>
        {location && (
          <span class="text-sm text-gray-400 dark:text-gray-500">
            📍 {location}
          </span>
        )}
      </div>

      <h1 class="text-3xl font-bold tracking-tight mb-4">{title}</h1>

      <div class="flex items-center gap-4 flex-wrap">
        <!-- 星级 -->
        <span class="inline-flex gap-0.5" title={t.eventDetail.importance(importance)}>
          {Array.from({ length: 5 }, (_, i) => (
            <span class={`text-sm ${i < importance ? 'text-yellow-500' : 'text-base-300'}`}>
              ★
            </span>
          ))}
        </span>

        <!-- 标签 -->
        {tags.length > 0 && (
          <div class="flex gap-1.5 flex-wrap">
            {tags.map((tag) => (
              <span class="badge badge-sm badge-ghost text-gray-500 dark:text-gray-400">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- 事件配图照片条 -->
    {
      images.length > 0 && (
        <div class="mb-10 space-y-3">
          <img
            src={to(images[0])}
            alt={title}
            class="w-full max-h-[420px] object-cover rounded-2xl shadow-md"
          />
          {
            images.length > 1 && (
              <div class="grid grid-cols-3 gap-3">
                {images.slice(1).map((img) => (
                  <img
                    src={to(img)}
                    alt={title}
                    loading="lazy"
                    class="w-full h-28 object-cover rounded-xl"
                  />
                ))}
              </div>
            )
          }
        </div>
      )
    }

    <!-- Markdown 正文 -->
    <div class="prose prose-gray dark:prose-invert max-w-none
                prose-headings:font-semibold prose-a:text-green-600 dark:text-green-400
                prose-img:rounded-xl prose-img:shadow-md
                prose-pre:bg-gray-200 dark:bg-gray-800
                prose-code:bg-gray-50 dark:bg-gray-950 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                prose-blockquote:border-green-500 prose-blockquote:bg-gray-50 dark:bg-gray-950
                prose-li:marker:text-gray-300 dark:text-gray-600">
      <Content />
    </div>

    <!-- 上一篇 / 下一篇导航 -->
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 grid grid-cols-2 gap-4">
      <div>
        {prevEntry ? (
          <a href={to(`/events/${getSlug(prevEntry)}`)}
             class="group card bg-base-100 border border-base-300 p-4 rounded-lg
                    hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.prev}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
              {prevEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.prev}</span>
            <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">—</p>
          </div>
        )}
      </div>
      <div>
        {nextEntry ? (
          <a href={to(`/events/${getSlug(nextEntry)}`)}
             class="group card bg-base-100 border border-base-300 p-4 rounded-lg text-right
                    hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.next}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
              {nextEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50 text-right">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.eventDetail.next}</span>
            <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">—</p>
          </div>
        )}
      </div>
    </nav>
  </article>
</Layout>
