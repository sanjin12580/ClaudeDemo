---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';
import { to, formatDate } from '../../lib/base';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
  }));
}

const { slug } = Astro.params;

const entries = await getCollection('blog');
const entry = entries.find((e) => e.id.replace(/\.(md|mdx)$/, '') === slug);
if (!entry) {
  return new Response(t.blog.notFound, { status: 404 });
}

const { Content } = await entry.render();
const { date, title, tags } = entry.data;


const allEntries = await getCollection('blog', ({ data }) => !data.draft);
allEntries.sort((a, b) => b.data.date.localeCompare(a.data.date));
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
const nextEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;

function getSlug(e: NonNullable<typeof entry>): string {
  return e.id.replace(/\.(md|mdx)$/, '');
}
---

<Layout title={title} description={entry.body?.replace(/[#*`>!\[\\\]()]/g, '').slice(0, 160) ?? ''}>
  <article class="max-w-3xl mx-auto">
    <!-- 返回链接 -->
    <a
      href={to('/blog')}
      class="inline-flex items-center gap-1 text-sm text-gray-400 dark:text-gray-500 hover:text-gray-900 dark:text-gray-100 transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {t.blog.backToList}
    </a>

    <!-- 元数据卡片 -->
    <header class="mb-10 p-6 rounded-xl bg-gray-50 dark:bg-gray-950 border border-gray-200 dark:border-gray-800">
      <time class="text-sm text-gray-500 dark:text-gray-400 font-mono tabular-nums">
        {formatDate(date)}
      </time>

      <h1 class="text-3xl font-bold tracking-tight mt-2 mb-4">{title}</h1>

      {tags.length > 0 && (
        <div class="flex gap-1.5 flex-wrap">
          {tags.map((tag) => (
            <a
              href={to(`/blog/tag/${tag}`)}
              class="badge badge-sm badge-ghost hover:badge-primary transition-all"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Markdown 正文 -->
    <div class="prose prose-gray dark:prose-invert max-w-none
                prose-headings:font-semibold prose-a:text-green-600 dark:text-green-400
                prose-img:rounded-xl prose-img:shadow-md
                prose-pre:bg-gray-200 dark:bg-gray-800
                prose-code:bg-gray-50 dark:bg-gray-950 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                prose-blockquote:border-green-500 prose-blockquote:bg-gray-50 dark:bg-gray-950
                prose-li:marker:text-gray-300 dark:text-gray-600">
      <Content />
    </div>

    <!-- 上一篇 / 下一篇导航 -->
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 grid grid-cols-2 gap-4">
      <div>
        {prevEntry ? (
          <a href={to(`/blog/${getSlug(prevEntry)}`)}
             class="group card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-4 rounded-lg
                    hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.blog.prevPost}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors line-clamp-1">
              {prevEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.blog.prevPost}</span>
            <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">{t.blog.noPrev}</p>
          </div>
        )}
      </div>
      <div>
        {nextEntry ? (
          <a href={to(`/blog/${getSlug(nextEntry)}`)}
             class="group card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-4 rounded-lg text-right
                    hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.blog.nextPost}</span>
            <p class="text-sm font-medium mt-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors line-clamp-1">
              {nextEntry.data.title}
            </p>
          </a>
        ) : (
          <div class="p-4 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 opacity-50 text-right">
            <span class="text-xs text-gray-400 dark:text-gray-500">{t.blog.nextPost}</span>
            <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">{t.blog.noNext}</p>
          </div>
        )}
      </div>
    </nav>
  </article>
</Layout>
