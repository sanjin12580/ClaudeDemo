---
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/BlogList';
import { loadPosts } from '../../lib/parsePosts';
import { t } from '../../lib/i18n';
import { to } from '../../lib/base';

const posts = await loadPosts();
---

<Layout title={t.blog.title} description={t.blog.description}>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t.blog.title}</h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">
        {t.blog.description}
      </p>
      <a
        href={to('/rss.xml')}
        class="inline-flex items-center gap-1.5 mt-3 text-sm text-green-600 dark:text-green-400 hover:underline"
      >
        📡 {t.blog.rss}
      </a>
    </div>

    <BlogList posts={posts} client:load />
  </div>
</Layout>
