---
// ============================================================
// /consumptions — 读书观影清单
// ============================================================

import Layout from '../../layouts/Layout.astro';
import ConsumptionList from '../../components/ConsumptionList';
import { loadConsumptions } from '../../lib/parseConsumptions';

const data = await loadConsumptions();
---

<Layout
  title="📚 读书观影"
  description="记录看过、在读、想看的书籍、电影、动漫等，附个人感受与随笔"
>
  <h1 className="text-2xl font-bold mb-2 flex items-center gap-2">
    📚 读书观影
  </h1>
  <p className="text-sm text-gray-500 dark:text-gray-400 mb-6">
    记录看过、在读、想看的书籍、小说、电影、电视剧、动漫、综艺、音乐
  </p>

  <ConsumptionList items={data.items} client:load />
</Layout>
