---
// ============================================================
// /consumptions — 读书观影清单
// ============================================================

import Layout from '../../layouts/Layout.astro';
import ConsumptionList from '../../components/ConsumptionList';
import { loadConsumptions } from '../../lib/parseConsumptions';
import { t } from '../../lib/i18n';

const data = await loadConsumptions();
const editable = import.meta.env.DEV;
---

<Layout
  title={t.consumptionsPage.heading}
  description={t.consumptionsPage.description}
>
  <h1 class="text-2xl font-bold mb-2 flex items-center gap-2">
    {t.consumptionsPage.heading}
  </h1>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
    {t.consumptionsPage.description}
  </p>

  <ConsumptionList items={data.items} editable={editable} client:load />
</Layout>
