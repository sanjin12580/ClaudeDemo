---
import '../styles/global.css';
import { t } from '../lib/i18n';
import { to } from '../lib/base';
import ThemeToggle from '../components/ThemeToggle';

export interface Props {
  title: string;
  description?: string;
  /** 是否使用宽屏布局（不限制最大宽度） */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;

// 当前路由路径（用于导航高亮）
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: to('/'), label: t.nav.home, match: (p: string) => p === to('/') || p === to('/').replace(/\/$/, '') },
  { href: to('/timeline'), label: t.nav.timeline, match: (p: string) => p.startsWith(to('/timeline')) },
  { href: to('/dashboard'), label: t.nav.dashboard, match: (p: string) => p.startsWith(to('/dashboard')) },
  { href: to('/bucket-list'), label: t.nav.bucketList, match: (p: string) => p.startsWith(to('/bucket-list')) },
  { href: to('/blog'), label: t.nav.blog, match: (p: string) => p.startsWith(to('/blog')) },
  { href: to('/trending'), label: t.nav.trending, match: (p: string) => p.startsWith(to('/trending')) },
  { href: to('/travel'), label: t.nav.travel, match: (p: string) => p.startsWith(to('/travel')) },
  { href: to('/gallery'), label: t.nav.gallery, match: (p: string) => p.startsWith(to('/gallery')) },
  { href: to('/consumptions'), label: t.nav.consumptions, match: (p: string) => p.startsWith(to('/consumptions')) },
  { href: to('/about'), label: t.nav.about, match: (p: string) => p.startsWith(to('/about')) },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || t.site.description} />
    <title>{title} — {t.site.title}</title>
    <link rel="icon" type="image/svg+xml" href={to('/favicon.svg')} />

    <!-- 防止暗色模式闪烁：在页面渲染前读取 localStorage / 系统偏好 -->
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme');
        var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dim');
        } else {
          document.documentElement.setAttribute('data-theme', 'emerald');
        }
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col">
    <!-- 导航栏 — 毛玻璃效果 -->
    <header class="sticky top-0 z-50 backdrop-blur-lg bg-white dark:bg-gray-900/70 border-b border-gray-200/50 dark:border-gray-800/50">
      <nav class="max-w-6xl mx-auto px-6 py-3 flex items-center gap-1">
        <!-- Logo / 首页 -->
        <a
          href={to('/')}
          class="text-lg font-bold tracking-tight px-3 py-1.5 rounded-lg hover:bg-gray-50 dark:bg-gray-950 transition-colors"
        >
          🌱 {t.site.title}
        </a>

        <div class="ml-2 flex items-center gap-0.5">
          {navLinks.slice(1).map((link) => {
            const isActive = link.match(currentPath);
            return (
              <a
                href={link.href}
                class={`text-sm px-3 py-1.5 rounded-lg transition-colors
                  ${isActive
                    ? 'bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-400 font-medium'
                    : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:bg-gray-950'
                  }`}
              >
                {link.label}
              </a>
            );
          })}
        </div>

        <div class="flex-1" />

        {import.meta.env.DEV && (
          <a
            href={to('/admin')}
            class="text-sm px-3 py-1.5 rounded-lg text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:bg-gray-950 transition-colors"
          >
            {t.nav.admin}
          </a>
        )}

        <ThemeToggle client:load />
      </nav>
    </header>

    <!-- 主内容 -->
    <main class={`flex-1 mx-auto px-6 py-8 w-full ${wide ? 'max-w-[90rem]' : 'max-w-6xl'}`}>
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="border-t border-gray-200/50 dark:border-gray-800/50 py-8 mt-12">
      <div class="max-w-6xl mx-auto px-6 text-center text-sm text-gray-400 dark:text-gray-500">
        <p>© {new Date().getFullYear()} {t.site.title} · {t.site.description}</p>
        <p class="mt-1">
          Built with Astro · React · Tailwind CSS · daisyUI
        </p>
      </div>
    </footer>
  </body>
</html>
